# GamerBrac Backend Environment Configuration
PROJECT_NAME="GamerBrac Esports Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security — replace these in your actual .env file
SECRET_KEY="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ROOM_ENCRYPTION_KEY="REPLACE_WITH_A_UNIQUE_ENCRYPTION_KEY"

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./gamerbrac.db"

# PostgreSQL deployment example — replace placeholders before use:
# DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE"

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
